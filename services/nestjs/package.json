{
  "name": "nestjs",
  "version": "1.0.0",
  "description": "NestJS service that communicates with mock AI server",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "run": "npm run build && npm run start:dev",
    "prisma:copy-from-shared": "mkdir -p ./prisma && cp ../../prisma/schema.prisma ./prisma/schema.prisma",
    "prisma:generate": "npm run prisma:copy-from-shared && npx prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.0.7",
    "@prisma/client": "6.5.0",
    "axios": "^1.8.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.13",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
